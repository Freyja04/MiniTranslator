#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MINITRANS_VERSION_TUPLE
 PRODUCTVERSION MINITRANS_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MiniTranslator\0"
            VALUE "FileDescription", "MiniTranslator\0"
            VALUE "FileVersion", MINITRANS_VERSION_STRING
            VALUE "InternalName", "MiniTranslator\0"
            VALUE "LegalCopyright", "Copyright (c) MiniTranslator contributors\0"
            VALUE "OriginalFilename", "MiniTranslator.exe\0"
            VALUE "ProductName", "MiniTranslator\0"
            VALUE "ProductVersion", MINITRANS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
